Manifest-Version: 1.0
Bundle-Category: idempiere-plugin
Bundle-ManifestVersion: 2
Bundle-Name: Promotions for iDempiere
Bundle-SymbolicName: org.idempiere.promotion
Bundle-Version: 13.0.0.202603311527
Export-Package: org.idempiere.model
Automatic-Module-Name: org.idempiere.promotion
Bundle-ActivationPolicy: lazy
Require-Bundle: org.adempiere.base;bundle-version="13.0.0",org.adempiere
 .plugin.utils;bundle-version="13.0.0"
Bundle-Activator: org.adempiere.plugin.utils.Incremental2PackActivator
Import-Package: org.osgi.service.event
Bundle-Vendor: iDempiere Community
Service-Component: OSGI-INF/*.xml
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=17))"

